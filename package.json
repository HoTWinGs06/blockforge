{
  "name": "blockforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "BlockForge \u2014 an original, unofficial Minecraft-inspired voxel sandbox.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "audit": "npm audit",
    "bench": "vitest bench",
    "build": "vite build",
    "check": "node scripts/verify.mjs --fast",
    "coverage": "vitest run --coverage",
    "coverage:unit": "vitest run --coverage --exclude '**/g2-smoke.test.ts'",
    "dev": "vite",
    "gate:bench": "tsc -p scripts/tsconfig.build.json && node node_modules/.cache/blockforge-scripts/scripts/bench/chunkBench.js",
    "gate:determinism": "tsc -p scripts/tsconfig.build.json && node node_modules/.cache/blockforge-scripts/scripts/determinism/check.js",
    "gate:selfcheck": "tsc -p scripts/tsconfig.build.json && node node_modules/.cache/blockforge-scripts/scripts/selfcheck/engineCheck.js && node node_modules/.cache/blockforge-scripts/scripts/selfcheck/meshCheck.js && node node_modules/.cache/blockforge-scripts/scripts/selfcheck/craftingCheck.js && node node_modules/.cache/blockforge-scripts/scripts/selfcheck/dropsCheck.js && node node_modules/.cache/blockforge-scripts/scripts/selfcheck/toolsCheck.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
